{
  "name": "@contribready/cli",
  "version": "0.1.0",
  "description": "CLI for ContribReady contributor-readiness audits",
  "type": "module",
  "bin": {
    "contribready": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "SUPPORT.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "assets/banner.svg"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ContribReady/contribready-cli.git"
  },
  "homepage": "https://github.com/ContribReady/contribready-cli#readme",
  "bugs": {
    "url": "https://github.com/ContribReady/contribready-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "test:package": "npm run build && node --test test/package-install.test.mjs",
    "pack:check": "npm pack --dry-run --cache .npm-cache",
    "verify": "npm run lint && npm test && npm run pack:check"
  },
  "dependencies": {
    "@contribready/core": "0.1.0"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "ajv-formats": "3.0.1",
    "typescript": "^5.0.0"
  },
  "license": "MIT"
}
